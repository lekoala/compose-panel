# Secrets for the Compose Panel deployment. NEVER commit the real file.
# Copy this example to compose-panel.env next to compose.yaml and fill it in:
#   cp compose-panel.env.example compose-panel.env
#   chmod 600 compose-panel.env
# Docker Compose applies variable interpolation to unquoted and double-quoted
# env_file values, so a "$" would be expanded. Single-quote any value that
# contains one (the password hash below, for instance).
# Use a unique username: common names (admin, root, ...) are refused unless
# COMPOSE_PANEL_DEV=true.
COMPOSE_PANEL_ADMIN_USER=operator
# Generate with the image (no Bun on the host needed):
#   read -rsp "Compose Panel password: " COMPOSE_PANEL_PASSWORD; echo
#   export COMPOSE_PANEL_PASSWORD
#   docker run --rm --entrypoint bun -e COMPOSE_PANEL_PASSWORD \
#     compose-panel:local src/scripts/hash-password.ts
#   unset COMPOSE_PANEL_PASSWORD
# Or, on a machine that already has Bun:  COMPOSE_PANEL_PASSWORD='...' bun run hash-password
# Keep the value in single quotes: the "$" in the hash must reach the panel literally.
COMPOSE_PANEL_ADMIN_PASSWORD_HASH='$argon2id$REPLACE_ME'
# Default: loopback only, reach it with `ssh -L5081:127.0.0.1:5081 you@host`.
# Behind one or more TLS reverse proxies on this host, list the origins
# (https only, comma-separated): Secure cookies and the forwarded client
# address follow the matched origin automatically. Add ALLOW_LOOPBACK=true to
# keep the SSH tunnel working alongside them.
# See docs/deployment.md, "Behind Caddy", and ADR 0012.
# COMPOSE_PANEL_PROXY_ORIGINS=https://panel.example.com
# COMPOSE_PANEL_ALLOW_LOOPBACK=false
# COMPOSE_PANEL_PUBLIC_ORIGIN and COMPOSE_PANEL_TRUST_PROXY are refused at
# startup since 0.1.1: rename to PROXY_ORIGINS and remove TRUST_PROXY.
# Display time zone for logs, the activity log and action start times (IANA
# name). Unset uses each reader's browser zone. Stored timestamps stay UTC.
# COMPOSE_PANEL_TIMEZONE=Europe/Brussels
