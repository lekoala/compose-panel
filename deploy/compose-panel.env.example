# Secrets for the Compose Panel deployment. NEVER commit the real file.
# Copy this example to compose-panel.env next to compose.yaml and fill it in:
#   cp compose-panel.env.example compose-panel.env
# Values in env_file are literal: no $ escaping needed.
# Use a unique username: common names (admin, root, ...) are refused unless
# COMPOSE_PANEL_DEV=true.
COMPOSE_PANEL_ADMIN_USER=operator
# Generate with:  COMPOSE_PANEL_PASSWORD='...' bun run hash-password
COMPOSE_PANEL_ADMIN_PASSWORD_HASH=$argon2id$REPLACE_ME
# Plain HTTP on the host loopback only. Behind TLS/a proxy, set true and read
# docs/security.md first.
COMPOSE_PANEL_COOKIE_SECURE=false
