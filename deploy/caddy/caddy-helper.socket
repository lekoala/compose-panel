# Compose Panel Caddy helper — systemd socket activation (ADR 0030).
#
# The helper runs on the HOST (not in the panel container) as the `caddy`
# user, one process per request, with no resident daemon. The panel reaches it
# through the socket below, mounted into the panel container (see
# docs/deployment.md and deploy/compose.yaml).
#
# Install: `sudo bash scripts/setup-caddy.sh --check`, then `--install`. It
# compiles the helper from the panel image, installs this unit and
# `caddy-helper@.service` (`Accept=yes` requires that template name) into
# /etc/systemd/system/, and enables this socket. The manual steps are listed
# in docs/deployment.md, "Manual setup".
[Unit]
Description=Compose Panel Caddy helper socket
Documentation=https://lekoala.github.io/compose-panel/

[Socket]
ListenStream=/run/compose-panel/caddy-helper.sock
SocketUser=caddy
SocketGroup=caddy
SocketMode=0660
# The directory is reserved for this socket and mounted into the panel
# container: root only, so no other host user can reach the helper.
DirectoryMode=0750
RemoveOnStop=yes
# One helper process per connection; its standard input/output IS the socket.
Accept=yes

[Install]
WantedBy=sockets.target
