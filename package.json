{
  "name": "compose-panel",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.4.4" },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "docker:build": "docker build -t compose-panel:local .",
    "verify": "bun test && bun check && bun fmt --check",
    "test:wsl": "wsl -- bash scripts/test-wsl.sh",
    "test:proxy:wsl": "wsl -- bash scripts/proxy-e2e/run.sh",
    "test:caddy:wsl": "wsl -- bash scripts/caddy-e2e.sh",
    "test:docker-lab:wsl": "wsl -- bash scripts/docker-lab/run.sh",
    "preview": "bun scripts/preview.ts",
    "docs:build": "bun scripts/build-docs.ts",
    "docs:preview": "bun scripts/build-docs.ts --serve",
    "hash-password": "bun src/scripts/hash-password.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
