# Minimal configuration for a manual or local Bun run.
#
# Copy this file to .env (never commit it). The Compose deployment uses
# deploy/compose-panel.env.example instead. The full reference, including
# integration, tuning, security relaxations and internal seams, is
# docs/configuration.md.

# Absolute path to an existing stacks directory. Host path and container path
# must match for the Compose deployment.
STACKS_DIR=/opt/stacks

# HTTP listener, always bound to 127.0.0.1 (not configurable). Reach it through
# an SSH tunnel or a TLS reverse proxy on the same host, never a published port.
PORT=5081

# Single administrator account. The password is never stored: only its hash.
# Generate the hash with:  COMPOSE_PANEL_PASSWORD='...' bun run hash-password
# Use a unique username: common names (admin, administrator, root, user, test,
# guest) are refused unless COMPOSE_PANEL_DEV=true.
COMPOSE_PANEL_ADMIN_USER=operator
COMPOSE_PANEL_ADMIN_PASSWORD_HASH=

# Behind one or more TLS reverse proxies on the same host (e.g. Caddy): the
# exact origins, comma-separated. Each request is resolved to an access point
# from its Host; Origin/Host, Secure cookies and X-Forwarded-For trust follow
# that point. Entries must be https (outside development), with no credentials,
# path, query or fragment, no empty entry and no duplicates. With no origin
# here, direct loopback (SSH tunnel) is the only path.
# See docs/configuration.md#access and ADR 0012.
# COMPOSE_PANEL_PROXY_ORIGINS=https://panel.example.com,https://oracle.example.ts.net

# Allow the loopback/SSH-tunnel path alongside the proxy origins above. Off by
# default when origins are configured; expose one path at a time unless the
# tunnel is needed for recovery.
# COMPOSE_PANEL_ALLOW_LOOPBACK=false

# Force Secure cookies on the loopback path (the proxy path already follows its
# origin scheme). Useful when the tunnel is itself wrapped in TLS.
# COMPOSE_PANEL_COOKIE_SECURE=false

# Optional: display time zone for logs, the activity log and action start times
# (IANA name). Unset uses each reader's browser zone; stored timestamps stay UTC.
# COMPOSE_PANEL_TIMEZONE=

# Optional: external database explorer linked from stacks that declare the
# `x-compose-panel.database` extension. Must be https outside development.
# See docs/integrations/libredb.md.
# COMPOSE_PANEL_DATABASE_EXPLORER_URL=https://db.example.com

# Audit logging is on by default under <STACKS_DIR>/.compose-panel/audit.
# Managed websites, Caddy site management, path aliases, timeouts, log/SSE caps,
# audit retention, development relaxations and the internal engine/executable
# seams are all documented in docs/configuration.md. They are not needed in a
# normal operator file.
