# Absolute path to an existing stacks directory.
STACKS_DIR=/opt/stacks

# Loopback-only HTTP listener. Do not expose it until the proxy/TLS review.
PORT=5081

# Single administrator account. The password is never stored: only its hash.
# Generate the hash with:  COMPOSE_PANEL_PASSWORD='...' bun run hash-password
COMPOSE_PANEL_ADMIN_USER=admin
COMPOSE_PANEL_ADMIN_PASSWORD_HASH=

# Cookies. Keep false only while the panel is served over plain HTTP on 127.0.0.1.
# Set true when the panel is served over TLS (directly or behind a reverse proxy).
COMPOSE_PANEL_COOKIE_SECURE=false

# Behind a reverse proxy: the exact public origin and whether to trust
# X-Forwarded-Proto / X-Forwarded-For. Leave unset for direct loopback use.
# COMPOSE_PANEL_PUBLIC_ORIGIN=https://panel.example.com
# COMPOSE_PANEL_TRUST_PROXY=true

# Optional overrides (defaults shown).
# COMPOSE_PANEL_SESSION_TTL_MS=43200000
# COMPOSE_PANEL_SESSION_IDLE_MS=3600000
# COMPOSE_PANEL_LOGIN_MAX_ATTEMPTS=5
# COMPOSE_PANEL_LOGIN_WINDOW_MS=900000
# COMPOSE_PANEL_LOGIN_BLOCK_MS=900000
# COMPOSE_PANEL_MAX_BODY_BYTES=8192
# COMPOSE_PANEL_MAX_EDIT_BYTES=1048576

# Docker CLI used for read-only state. Fixed executable and explicit argument
# arrays only: never a shell, never user-supplied options.
# COMPOSE_PANEL_DOCKER_PATH=docker
# COMPOSE_PANEL_DOCKER_TIMEOUT_MS=5000
# COMPOSE_PANEL_DOCKER_MAX_BYTES=1048576
