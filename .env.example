# Absolute path to an existing stacks directory.
STACKS_DIR=/opt/stacks

# HTTP listener, always bound to 127.0.0.1 (not configurable). Reach it through
# an SSH tunnel or a TLS reverse proxy on the same host, never a published port.
PORT=5081

# Single administrator account. The password is never stored: only its hash.
# Generate the hash with:  COMPOSE_PANEL_PASSWORD='...' bun run hash-password
# Use a unique username: common names (admin, administrator, root, user, test,
# guest) are refused unless COMPOSE_PANEL_DEV=true.
COMPOSE_PANEL_ADMIN_USER=operator
COMPOSE_PANEL_ADMIN_PASSWORD_HASH=

# Behind one or more TLS reverse proxies on the same host (e.g. Caddy): the
# exact origins, comma-separated. Each request is resolved to an access point
# from its Host; Origin/Host, Secure cookies and X-Forwarded-For trust follow
# that point. Entries must be https (outside COMPOSE_PANEL_DEV), with no
# credentials, path, query or fragment, no empty entry and no duplicates.
# With no origin here, direct loopback (SSH tunnel)
# is the only path. See docs/deployment.md, ADR 0012.
# COMPOSE_PANEL_PROXY_ORIGINS=https://panel.example.com,https://oracle.example.ts.net

# Allow the loopback/SSH-tunnel path alongside the proxy origins above. Off by
# default when origins are configured (use one path at a time). The loopback
# path uses non-Secure cookies unless COMPOSE_PANEL_COOKIE_SECURE=true.
# COMPOSE_PANEL_ALLOW_LOOPBACK=false

# COMPOSE_PANEL_PUBLIC_ORIGIN and COMPOSE_PANEL_TRUST_PROXY were removed in
# 0.2.0 and are refused at startup: rename to COMPOSE_PANEL_PROXY_ORIGINS and
# drop TRUST_PROXY. See the changelog for the migration.

# Local testing only. When true, a mutating request whose Origin is absent or the
# opaque "null" (an embedded/sandboxed context) is accepted if Fetch Metadata
# says same-origin/none. Default false: the panel must not be driven from an
# iframe. Never enable this on a shared or exposed host.
# COMPOSE_PANEL_ALLOW_OPAQUE_ORIGIN=false

# Development/debug mode for local work only. Allows weak conveniences such as
# the "admin" username. Never enable on a shared or exposed host.
# COMPOSE_PANEL_DEV=false

# Optional overrides (defaults shown).
# COMPOSE_PANEL_SESSION_TTL_MS=43200000
# COMPOSE_PANEL_SESSION_IDLE_MS=3600000
# COMPOSE_PANEL_LOGIN_MAX_ATTEMPTS=5
# COMPOSE_PANEL_LOGIN_WINDOW_MS=900000
# Over the limit, attempts are delayed (doubling from 250 ms up to this cap),
# never refused: there is no lockout an attacker could turn against the admin.
# COMPOSE_PANEL_LOGIN_BACKOFF_MAX_MS=2000

# Activity log (sign-ins, saves, actions) as daily NDJSON files under
# <STACKS_DIR>/.compose-panel/audit unless overridden. Each file is size-capped.
# COMPOSE_PANEL_AUDIT_ENABLED=true
# COMPOSE_PANEL_AUDIT_DIR=
# COMPOSE_PANEL_AUDIT_ROTATION=day
# COMPOSE_PANEL_AUDIT_RETAIN_FILES=31
# COMPOSE_PANEL_AUDIT_MAX_FILE_BYTES=10485760
# COMPOSE_PANEL_AUDIT_MAX_READ_LINES=2000

# COMPOSE_PANEL_MAX_BODY_BYTES=8192
# COMPOSE_PANEL_MAX_EDIT_BYTES=1048576

# Backups kept per file (compose.yaml, .env) of each stack. Every save copies
# the previous version to <stacks>/.compose-panel/backups/<stack>/; older
# copies beyond this count are deleted after the save. They can also be
# deleted by hand from the stack's edit page.
# COMPOSE_PANEL_BACKUP_RETAIN=10

# Compose engine/provider. V1 supports "docker" only; "podman" is not
# implemented yet and is rejected explicitly.
# COMPOSE_PANEL_COMPOSE_ENGINE=docker

# Optional external database explorer (LibreDB Studio, Adminer, pgAdmin…). When
# set, a stack that declares an `x-compose-panel.database` extension (a label
# and scalar query parameters) shows an "Explore the database" link on its page.
# Query values are strings or booleans; quote numeric values (`port: '5432'`),
# since YAML would otherwise rewrite their form. Compose Panel only builds the
# link: it never contacts the explorer, reads no credential and opens no
# database. The explorer stays private (reverse proxy + VPN) and the target
# system applies the real read restrictions. Must be https outside
# COMPOSE_PANEL_DEV, with no credentials, path, query or fragment (V1 assumes an
# explorer served at the root of its domain).
# See docs/integrations/libredb.md for a LibreDB Studio example.
# COMPOSE_PANEL_DATABASE_EXPLORER_URL=https://db.example.com

# Optional Caddy site management (ADR 0030). When true, the stack page shows a
# Domains section: always a preview of the managed Caddy file, plus real
# attach/detach when the helper socket below is set. False (default) means no
# section, no socket access, no new dependency.
# COMPOSE_PANEL_CADDY_ENABLED=false

# Unix socket of the privileged Caddy helper on the host, mounted into the
# panel container through its directory (e.g. /run/compose-panel:/run/compose-panel:ro).
# Empty (default) means Domains stays a preview: nothing can be attached.
# Setting it without COMPOSE_PANEL_CADDY_ENABLED=true is refused at startup.
# See docs/deployment.md for the helper install (systemd socket + service).
# COMPOSE_PANEL_CADDY_SOCKET_PATH=

# Docker CLI used for read-only state. Fixed executable and explicit argument
# arrays only: never a shell, never user-supplied options.
# COMPOSE_PANEL_DOCKER_PATH=docker
# COMPOSE_PANEL_DOCKER_TIMEOUT_MS=5000
# COMPOSE_PANEL_DOCKER_MAX_BYTES=1048576

# Read-only Server page (engine facts, per-container stats): per-call timeout
# for `docker info`/`stats`, and how long the on-demand `docker system df`
# read is cached in memory (it can be expensive on a large host, so it is
# never part of a normal page load or live refresh).
# COMPOSE_PANEL_INSIGHTS_TIMEOUT_MS=10000
# COMPOSE_PANEL_DISK_USAGE_TTL_MS=300000

# After a migration where the Docker-side Compose file path (a container
# label) differs from the panel's mount, remap host prefixes to panel
# prefixes so containers are still matched to their stack. Empty by default.
# COMPOSE_PANEL_STACKS_PATH_ALIASES=/host/stacks=/opt/stacks

# Mutating operations: maximum duration and the bounded drain window on shutdown.
# COMPOSE_PANEL_OPERATION_TIMEOUT_MS=300000
# COMPOSE_PANEL_SHUTDOWN_GRACE_MS=30000

# Live streams (SSE): heartbeat interval, maximum stream lifetime, and the
# process-wide cap on concurrent subscriptions.
# COMPOSE_PANEL_SSE_HEARTBEAT_MS=15000
# COMPOSE_PANEL_SSE_TIMEOUT_MS=1800000
# COMPOSE_PANEL_SSE_MAX_SUBSCRIBERS=100

# `compose logs --follow`: tailed history, retained buffer cap per stack, and
# maximum follow lifetime. The follow subprocess is killed when the last
# reader leaves or when the timeout fires.
# COMPOSE_PANEL_LOG_TAIL_LINES=200
# COMPOSE_PANEL_LOG_MAX_BYTES=262144
# COMPOSE_PANEL_LOG_TIMEOUT_MS=1800000

# Display time zone for every rendered time: container logs, the activity log
# and action start times. An IANA name (e.g. Europe/Brussels). Leave unset to
# use each reader's browser time zone. Timestamps stay stored and emitted in
# UTC; this only changes presentation.
# COMPOSE_PANEL_TIMEZONE=
