# Normalize line endings in the repository to LF.
# The panel runs on Linux and the quality gates are Linux-based, so tracking
# LF avoids CRLF leaking into shell scripts, Compose files and lockfiles.
* text=auto eol=lf

# Source, config and docs are always LF.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.env  text eol=lf
*.example text eol=lf
bun.lock    text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Shell scripts must stay LF on Linux.
*.sh text eol=lf

# Windows-only scripts keep CRLF for native tooling.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
